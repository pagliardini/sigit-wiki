---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<div class="logo-title">
			<a href="/">
				<img src="/logo.png" alt="SIGIT Logo" class="nav-logo" />
				<h2>{SITE_TITLE}</h2>
			</a>
		</div>
		<div class="internal-links">
			<HeaderLink href="/">Inicio</HeaderLink>
			<HeaderLink href="/manual-usuario/">Manual de Usuario</HeaderLink>
		</div>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	.logo-title a {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		padding: 0.5em 0;
	}
	.nav-logo {
		height: 32px;
		width: auto;
	}
	h2 {
		margin: 0;
		font-size: 1.1em;
		color: var(--black);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
</style>

