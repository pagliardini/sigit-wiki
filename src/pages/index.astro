---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="hero">
				<img src="/logo.png" alt="SIGIT Logo" class="hero-logo" />
				<h1 class="subtitle">
					Sistema de Gestión de Infraestructura Tecnológica
				</h1>
				<div class="doc-banner">
					<div class="doc-info">
						<strong>Documentación del proyecto:</strong>
						<a href="https://sigit.pagliardini.com/manual-usuario" class="doc-link">
							sigit.pagliardini.com/manual-usuario
						</a>
					</div>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	:global(body) {
		background: #0f172a !important;
		color: #f8fafc !important;
	}
	.hero {
		text-align: center;
		padding: 4rem 0;
	}
	.hero-logo {
		width: 180px;
		height: auto;
		margin-bottom: 1.5rem;
		filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.4));
	}
	.subtitle {
		font-size: 1.5rem;
		font-weight: 500;
		color: #94a3b8;
		margin-bottom: 2.5rem;
	}
	.doc-banner {
		display: inline-flex;
		align-items: center;
		background: #1e293b;
		border: 1px solid #334155;
		padding: 1rem 1.5rem;
		border-radius: 10px;
		font-size: 1rem;
		text-align: left;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
	}
	.doc-info {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		color: #e2e8f0;
	}
	.doc-link {
		color: #38bdf8;
		font-weight: 600;
		text-decoration: underline;
		margin-top: 0.2rem;
	}
	.doc-link:hover {
		color: #7dd3fc;
	}
</style>



