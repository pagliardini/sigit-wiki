---
// Landing de SIGIT. Página independiente: el manual (/manual-usuario) lo sirve Starlight.
const SITE = 'https://sigit.pagliardini.com';
const DEMO_URL = 'https://demo.sigit.pagliardini.com';
// Casilla que recibe las consultas (botón de email y respaldo del formulario).
const CONTACT_EMAIL = 'sigit@pagliardini.com';
// Opcional: endpoint que recibe el formulario como JSON (Formspree, Web3Forms, un Worker...).
// Vacío: el formulario abre el cliente de correo con la consulta ya escrita.
const FORM_ENDPOINT = 'https://formspree.io/f/xwlvnyrp';

const title = 'SIGIT — Gestión de activos e inventario de TI';
const description =
	'Inventario de equipos, consumibles, transferencias entre sedes, compras y préstamos en un solo sistema. ' +
	'Instalado y mantenido para tu área de TI. Probá la demo.';

const features = [
	{ icon: 'laptop', title: 'Activos con historia', text: 'Cada equipo con su tag, número de serie, modelo, estado, costo y factura. Quién lo tuvo, dónde estuvo y qué le pasó, sin planillas paralelas.' },
	{ icon: 'person', title: 'Asignaciones claras', text: 'Asigná un equipo a una persona, a una ubicación o a otro activo (el monitor va con la PC). El historial queda solo.' },
	{ icon: 'box', title: 'Consumibles y stock', text: 'Tóners, cables y repuestos con stock por sede, alertas de stock bajo, vencimientos y reposiciones pendientes de compra.' },
	{ icon: 'arrows', title: 'Transferencias entre sedes', text: 'Mandá equipos e insumos de una sede a otra con remito digital. La sede destino recibe un aviso y confirma la llegada.' },
	{ icon: 'receipt', title: 'Compras y facturas', text: 'Proveedores y facturas de compra: al procesar una factura, los equipos se dan de alta en el inventario con su costo.' },
	{ icon: 'handoff', title: 'Préstamos y kiosco', text: 'Préstamos de notebooks, proyectores o lo que sea, con vencimientos. Un modo kiosco en tablet para prestar y devolver en mostrador.' },
	{ icon: 'qr', title: 'Etiquetas con QR', text: 'Imprimí etiquetas con código QR y de barras, y encontrá cualquier equipo escaneando o buscando por tag.' },
	{ icon: 'shield', title: 'Roles y sedes', text: 'Cada técnico ve y opera solo sobre sus sedes; los administradores ven todo. Log de auditoría de cada cambio.' },
	{ icon: 'chart', title: 'Reportes y exportaciones', text: 'Dashboard con lo que necesita atención, reportes por sede, categoría o centro de costo, y exportación a Excel y PDF.' },
];

const screens = [
	{ id: 'activos', label: 'Inventario', alt: 'Listado de activos con filtros por estado, categoría y sede' },
	{ id: 'dashboard', label: 'Dashboard', alt: 'Dashboard con totales de activos, asignados, consumibles y stock bajo' },
	{ id: 'activo', label: 'Ficha de un activo', alt: 'Ficha de un activo con su historial de asignaciones' },
	{ id: 'consumibles', label: 'Consumibles', alt: 'Listado de consumibles con stock por sede' },
	{ id: 'transferencias', label: 'Transferencias', alt: 'Transferencias entre sedes con su estado' },
];

const service = [
	{ title: 'Instalado y funcionando', text: 'Tu instancia propia, aislada de otros clientes, en tu dominio con HTTPS. Con tu logo, tus sedes y tus catálogos cargados.' },
	{ title: 'Siempre actualizado', text: 'Las mejoras llegan solas, solo después de pasar las pruebas automáticas. Sin ventanas de mantenimiento que coordinar.' },
	{ title: 'Backups fuera del servidor', text: 'Copias diarias cifradas en otro proveedor, con historial de meses. Restaurar está probado, no es una promesa.' },
	{ title: 'Soporte en serio', text: 'Capacitación inicial para el equipo y soporte directo con quien desarrolla el sistema, sin mesa de ayuda de por medio.' },
];

const steps = [
	{ title: 'Probá la demo', text: 'Entrá con cualquiera de las cuentas de ejemplo y recorré el sistema. Sin registrarte.' },
	{ title: 'Hablemos', text: 'Contanos cuántas sedes y equipos tienen y cómo trabajan hoy. Vemos juntos qué necesitan.' },
	{ title: 'Empezá a usarlo', text: 'Preparamos tu instancia, cargamos los catálogos y capacitamos al equipo. En días, no meses.' },
];

const faqs = [
	{ q: '¿Tenemos que instalar algo?', a: 'No. SIGIT funciona en el navegador, desde la PC, la tablet o el celular. Nosotros nos ocupamos del servidor, las actualizaciones y los backups.' },
	{ q: '¿Dónde quedan nuestros datos?', a: 'En una instancia exclusiva para tu organización, con su propia base de datos, separada de otros clientes. Podés exportar todo a Excel cuando quieras.' },
	{ q: '¿Se puede instalar en nuestros servidores?', a: 'Sí. Si por política los datos tienen que quedar en tu infraestructura, lo instalamos ahí (Linux con Docker o Debian) y lo mantenemos igual.' },
	{ q: '¿Podemos cargar lo que ya tenemos en planillas?', a: 'Sí: los catálogos (categorías, marcas, modelos, ubicaciones) se importan desde Excel, y te ayudamos con la carga inicial del inventario.' },
	{ q: '¿Cuánto cuesta?', a: 'Depende de la cantidad de sedes y de si va en nuestra nube o en tu servidor. Escribinos y te pasamos una propuesta.' },
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={`${SITE}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#14295a" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={`${SITE}/`} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={`${SITE}/og.png`} />
		<meta property="og:locale" content="es_AR" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="preload" as="image" href="/screens/activos-dark.webp" />
	</head>
	<body>
		<a class="skip" href="#contenido">Ir al contenido</a>

		<header class="nav">
			<div class="wrap nav-inner">
				<a href="/" class="brand" aria-label="SIGIT, inicio">
					<img src="/logo.png" alt="SIGIT" width="112" height="35" />
				</a>
				<nav aria-label="Principal">
					<a href="#funciones">Funciones</a>
					<a href="#servicio">Servicio</a>
					<a href="/manual-usuario/">Manual</a>
					<a href="#contacto" class="nav-cta">Contacto</a>
				</nav>
			</div>
		</header>

		<main id="contenido">
			<section class="hero">
				<div class="wrap hero-inner">
					<p class="eyebrow">Gestión de activos de TI</p>
					<h1>Todo el inventario de TI,<br class="br-wide" /> en un solo lugar y al día.</h1>
					<p class="lead">
						SIGIT registra cada equipo, consumible y movimiento entre sedes: quién lo tiene, dónde está, cuánto costó
						y cuándo hay que reponer. Hecho para áreas de TI que dejaron atrás la planilla.
					</p>
					<div class="actions">
						<a class="btn btn-primary" href={DEMO_URL} target="_blank" rel="noopener">Probar la demo <span aria-hidden="true">→</span></a>
						<a class="btn btn-ghost" href="#contacto">Hablemos</a>
					</div>
					<p class="hint">Sin registrarte · datos de ejemplo · se reinicia cada hora</p>
				</div>
				<div class="wrap">
					<figure class="hero-shot">
						<div class="window">
							<div class="window-bar" aria-hidden="true"><span></span><span></span><span></span></div>
							<img src="/screens/activos-dark.webp" width="1440" height="900"
								alt="SIGIT: listado de activos con tag, modelo, número de serie, estado y sede" />
						</div>
					</figure>
				</div>
			</section>

			<section class="proof">
				<div class="wrap proof-inner">
					<p><strong>En producción</strong> en el área de TI de una universidad con varias sedes.</p>
					<ul>
						<li>Activos</li><li>Consumibles</li><li>Transferencias</li><li>Compras</li><li>Préstamos</li><li>Auditoría</li>
					</ul>
				</div>
			</section>

			<section id="funciones" class="section">
				<div class="wrap">
					<header class="section-head">
						<p class="eyebrow">Funciones</p>
						<h2>Lo que hoy está en cinco planillas y tres mails, en un solo sistema</h2>
					</header>
					<div class="grid features">
						{features.map((f) => (
							<article class="feature">
								<span class={`ico ico-${f.icon}`} aria-hidden="true"></span>
								<h3>{f.title}</h3>
								<p>{f.text}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<section class="section section-alt" aria-labelledby="recorrido">
				<div class="wrap">
					<header class="section-head">
						<p class="eyebrow">Recorrido</p>
						<h2 id="recorrido">Pensado para el trabajo de todos los días</h2>
					</header>
					<div class="tour">
						<div class="tabs" role="tablist" aria-label="Pantallas de SIGIT">
							{screens.map((s, i) => (
								<button type="button" role="tab" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`}
									aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{s.label}</button>
							))}
						</div>
						{screens.map((s, i) => (
							<div class="panel" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} hidden={i !== 0}>
								<div class="window">
									<div class="window-bar" aria-hidden="true"><span></span><span></span><span></span></div>
									<picture>
										<source srcset={`/screens/${s.id}-dark.webp`} media="(prefers-color-scheme: dark)" />
										<img src={`/screens/${s.id}-light.webp`} width="1440" height="900" alt={s.alt} loading="lazy" />
									</picture>
								</div>
							</div>
						))}
					</div>

					<div class="split">
						<div>
							<p class="eyebrow">Kiosco de préstamos</p>
							<h3>Una tablet en el mostrador y listo</h3>
							<p>
								El modo kiosco deja prestar y devolver equipos con dos botones, buscando al usuario por legajo, DNI o el
								identificador que use tu organización. Los vencimientos aparecen en el dashboard.
							</p>
						</div>
						<div class="tablet">
							<img src="/screens/kiosco.webp" width="1440" height="1080" loading="lazy"
								alt="Modo kiosco de préstamos con botones Prestar y Devolver" />
						</div>
					</div>
				</div>
			</section>

			<section id="servicio" class="section">
				<div class="wrap">
					<header class="section-head">
						<p class="eyebrow">Servicio</p>
						<h2>Vos usás el sistema. Del resto nos ocupamos nosotros.</h2>
					</header>
					<div class="grid service">
						{service.map((s) => (
							<article class="service-item">
								<span class="check" aria-hidden="true"></span>
								<div>
									<h3>{s.title}</h3>
									<p>{s.text}</p>
								</div>
							</article>
						))}
					</div>

					<ol class="steps">
						{steps.map((s, i) => (
							<li>
								<span class="step-n">{i + 1}</span>
								<h3>{s.title}</h3>
								<p>{s.text}</p>
							</li>
						))}
					</ol>
				</div>
			</section>

			<section class="section section-alt" aria-labelledby="preguntas">
				<div class="wrap narrow">
					<header class="section-head">
						<p class="eyebrow">Preguntas frecuentes</p>
						<h2 id="preguntas">Lo que suelen preguntarnos</h2>
					</header>
					<div class="faq">
						{faqs.map((f) => (
							<details>
								<summary>{f.q}</summary>
								<p>{f.a}</p>
							</details>
						))}
					</div>
				</div>
			</section>

			<section id="contacto" class="section contact">
				<div class="wrap contact-inner">
					<div class="contact-copy">
						<p class="eyebrow">Contacto</p>
						<h2>Contanos cómo gestionan hoy el inventario</h2>
						<p>Te respondemos a la brevedad con una propuesta para tu organización, o coordinamos una llamada para verlo juntos.</p>
						<p class="contact-mail">
							O escribinos directo a <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
						</p>
						<p class="contact-demo">
							¿Todavía no la viste? <a href={DEMO_URL} target="_blank" rel="noopener">Probá la demo →</a>
						</p>
					</div>
					<form class="form" id="contact-form" data-endpoint={FORM_ENDPOINT} data-email={CONTACT_EMAIL} novalidate>
						<div class="row">
							<label>Nombre<input name="nombre" autocomplete="name" required /></label>
							<label>Organización<input name="organizacion" autocomplete="organization" required /></label>
						</div>
						<div class="row">
							<label>Email<input name="email" type="email" autocomplete="email" required /></label>
							<label>Cantidad de equipos (aprox.)
								<select name="equipos">
									<option>Menos de 200</option>
									<option>200 a 1.000</option>
									<option>1.000 a 5.000</option>
									<option>Más de 5.000</option>
								</select>
							</label>
						</div>
						<label>Mensaje<textarea name="mensaje" rows="4" placeholder="Sedes, cómo lo llevan hoy, qué les gustaría resolver..."></textarea></label>
						<input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
						<button class="btn btn-primary" type="submit">Enviar consulta</button>
						<p class="form-status" role="status" aria-live="polite"></p>
					</form>
				</div>
			</section>
		</main>

		<footer class="footer">
			<div class="wrap footer-inner">
				<img src="/logo.png" alt="SIGIT" width="96" height="30" />
				<nav aria-label="Pie">
					<a href={DEMO_URL} target="_blank" rel="noopener">Demo</a>
					<a href="/manual-usuario/">Manual de usuario</a>
					<a href="#contacto">Contacto</a>
				</nav>
				<p>© {year} SIGIT · Sistema de Gestión de Infraestructura Tecnológica</p>
			</div>
		</footer>

		<script>
			// Pestañas del recorrido (con teclado: flechas, Inicio, Fin)
			const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
			const select = (tab: HTMLButtonElement) => {
				tabs.forEach((t) => {
					const on = t === tab;
					t.setAttribute('aria-selected', String(on));
					t.tabIndex = on ? 0 : -1;
					document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
				});
			};
			tabs.forEach((tab, i) => {
				tab.addEventListener('click', () => select(tab));
				tab.addEventListener('keydown', (e) => {
					const next = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
					if (next === undefined) return;
					e.preventDefault();
					const t = tabs[(next + tabs.length) % tabs.length];
					select(t);
					t.focus();
				});
			});

			// Formulario: a FORM_ENDPOINT si está configurado; si no, abre el correo con la consulta escrita
			const form = document.getElementById('contact-form') as HTMLFormElement;
			const status = form.querySelector('.form-status') as HTMLElement;
			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				if (!form.reportValidity()) return;
				const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
				if (data._gotcha) return;
				delete data._gotcha;
				const endpoint = form.dataset.endpoint;
				if (!endpoint) {
					const body = `Nombre: ${data.nombre}\nOrganización: ${data.organizacion}\nEmail: ${data.email}\n` +
						`Equipos: ${data.equipos}\n\n${data.mensaje}`;
					location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent('Consulta SIGIT — ' + data.organizacion)}` +
						`&body=${encodeURIComponent(body)}`;
					status.textContent = 'Se abrió tu programa de correo con la consulta lista para enviar.';
					return;
				}
				data._subject = `Consulta SIGIT — ${data.organizacion}`; // asunto del mail (Formspree)
				const button = form.querySelector('button') as HTMLButtonElement;
				button.disabled = true;
				status.textContent = 'Enviando...';
				try {
					const res = await fetch(endpoint, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
						body: JSON.stringify(data),
					});
					if (!res.ok) throw new Error(String(res.status));
					form.reset();
					status.textContent = '¡Gracias! Te respondemos a la brevedad.';
				} catch {
					status.textContent = `No se pudo enviar. Escribinos a ${form.dataset.email}.`;
				} finally {
					button.disabled = false;
				}
			});
		</script>
	</body>
</html>

<style is:global>
	:root {
		--navy: #14295a;
		--navy-2: #1c3b72;
		--blue: #2563eb;
		--blue-2: #1d4ed8;
		--sky: #7dd3fc;
		--ink: #0f172a;
		--text: #334155;
		--muted: #64748b;
		--bg: #ffffff;
		--bg-alt: #f5f7fb;
		--card: #ffffff;
		--line: #e2e8f0;
		--radius: 14px;
		--shadow: 0 1px 2px rgb(15 23 42 / 6%), 0 8px 24px rgb(15 23 42 / 8%);
		color-scheme: light dark;
	}
	@media (prefers-color-scheme: dark) {
		:root {
			--ink: #f1f5f9;
			--text: #cbd5e1;
			--muted: #94a3b8;
			--bg: #0b1220;
			--bg-alt: #0f1a2e;
			--card: #13203a;
			--line: #22314f;
			--shadow: 0 1px 2px rgb(0 0 0 / 30%), 0 8px 24px rgb(0 0 0 / 35%);
		}
	}
	*, *::before, *::after { box-sizing: border-box; }
	html { scroll-behavior: smooth; scroll-padding-top: 72px; }
	@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
	body {
		margin: 0;
		font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
		font-size: 17px;
		line-height: 1.6;
		color: var(--text);
		background: var(--bg);
		-webkit-font-smoothing: antialiased;
	}
	img { max-width: 100%; height: auto; display: block; }
	a { color: var(--blue); }
	h1, h2, h3 { color: var(--ink); line-height: 1.15; margin: 0; letter-spacing: -0.02em; }
	h2 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); }
	h3 { font-size: 1.1rem; letter-spacing: -0.01em; }
	p { margin: 0; }
	.wrap { width: min(1160px, 100% - 32px); margin-inline: auto; }
	.narrow { width: min(780px, 100% - 32px); }
	.skip { position: absolute; left: -999px; top: 8px; background: #fff; color: var(--navy); padding: 8px 12px; z-index: 100; border-radius: 6px; }
	.skip:focus { left: 8px; }
	:focus-visible { outline: 3px solid var(--sky); outline-offset: 2px; border-radius: 6px; }

	/* Nav */
	.nav { position: sticky; top: 0; z-index: 50; background: rgb(20 41 90 / 92%); backdrop-filter: saturate(140%) blur(10px); border-bottom: 1px solid rgb(255 255 255 / 8%); }
	.nav-inner { display: flex; align-items: center; justify-content: space-between; height: 60px; gap: 16px; }
	.brand img { height: 30px; width: auto; }
	.nav nav { display: flex; align-items: center; gap: 4px; }
	.nav nav a { color: #dbe4f3; text-decoration: none; font-size: 0.95rem; padding: 8px 12px; border-radius: 8px; }
	.nav nav a:hover { color: #fff; background: rgb(255 255 255 / 8%); }
	.nav .nav-cta { background: #fff; color: var(--navy); font-weight: 600; }
	.nav .nav-cta:hover { background: #e8eefb; color: var(--navy); }
	@media (max-width: 640px) {
		.nav nav a:not(.nav-cta):not([href^="/manual"]) { display: none; }
		.nav nav a { padding: 7px 10px; }
	}

	/* Hero */
	.hero {
		background:
			radial-gradient(900px 420px at 80% -10%, rgb(56 189 248 / 22%), transparent 60%),
			radial-gradient(700px 380px at 0% 0%, rgb(37 99 235 / 30%), transparent 60%),
			linear-gradient(180deg, var(--navy) 0%, var(--navy-2) 62%, var(--bg) 62%);
		color: #dbe4f3;
		padding-top: clamp(56px, 9vw, 104px);
	}
	.hero-inner { text-align: center; max-width: 860px; }
	.eyebrow { text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.78rem; font-weight: 700; color: var(--blue); margin-bottom: 12px; }
	.hero .eyebrow { color: var(--sky); }
	.hero h1 { color: #fff; font-size: clamp(2.1rem, 5.4vw, 3.6rem); letter-spacing: -0.03em; }
	.lead { font-size: clamp(1.05rem, 1.8vw, 1.22rem); margin: 22px auto 0; max-width: 680px; color: #c7d4ea; }
	.actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 32px; }
	.btn { display: inline-flex; align-items: center; gap: 8px; padding: 13px 22px; border-radius: 10px; font-weight: 600; font-size: 1rem; text-decoration: none; border: 1px solid transparent; cursor: pointer; font-family: inherit; transition: background 0.15s, transform 0.15s; }
	.btn:hover { transform: translateY(-1px); }
	.btn-primary { background: var(--blue); color: #fff; box-shadow: 0 6px 20px rgb(37 99 235 / 35%); }
	.btn-primary:hover { background: var(--blue-2); }
	.btn-primary:disabled { opacity: 0.6; transform: none; }
	.btn-ghost { color: #fff; border-color: rgb(255 255 255 / 30%); }
	.btn-ghost:hover { background: rgb(255 255 255 / 10%); }
	.hint { margin-top: 14px; font-size: 0.88rem; color: #9fb2d3; }
	.hero-shot { margin: clamp(40px, 6vw, 64px) auto 0; max-width: 1080px; }
	@media (max-width: 720px) { .br-wide { display: none; } }

	.window { border-radius: 12px; overflow: hidden; background: #1e293b; box-shadow: 0 30px 80px rgb(2 6 23 / 35%), 0 0 0 1px rgb(255 255 255 / 8%); }
	.window-bar { display: flex; gap: 6px; padding: 10px 12px; background: #1e293b; }
